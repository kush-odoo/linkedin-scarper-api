ENVIRONMENT=production
PORT=8000
WORKERS=4

# Secret API Token for clients accessing this microservice
API_AUTH_TOKEN=generate_a_secure_random_token_here

# Backend LinkedIn Session Credentials (From logged-in session cookies)
LINKEDIN_LI_AT=AQED...
LINKEDIN_JSESSIONID="ajax:1234567890"

# Optional SOCKS5h Proxy String
PROXY_DSN=socks5h://user:pass@proxy.example.com:1080

MAX_CONCURRENT_REQUESTS=30
REQUEST_TIMEOUT_SECONDS=15.0
